# Local development environment configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock/Local simulation mode enabled so dev server runs out of the box!
ENABLE_LOCAL_MOCK_FALLBACK="true"

# Clerk (Set your real keys from https://dashboard.clerk.com when ready)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_sample_clerk_key"
CLERK_SECRET_KEY="sk_test_sample_clerk_secret"
CLERK_WEBHOOK_SECRET="whsec_sample_secret"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Database Configuration (Prisma ORM):
# SQLite (Default for zero-dependency local dev):
DATABASE_URL="file:./dev.db"

# Production Neon Serverless PostgreSQL (https://neon.tech):
# DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"
# DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"

# Supabase (Set your real keys from https://supabase.com when ready)
NEXT_PUBLIC_SUPABASE_URL="https://example.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon_key_placeholder"
SUPABASE_SERVICE_ROLE_KEY="service_role_key_placeholder"

# Lemon Squeezy (Set your real keys from https://app.lemonsqueezy.com when ready)
LEMONSQUEEZY_API_KEY="lemonsqueezy_api_key_placeholder"
LEMONSQUEEZY_STORE_ID="store_id_placeholder"
LEMONSQUEEZY_WEBHOOK_SECRET="webhook_secret_placeholder"
NEXT_PUBLIC_LEMON_PRO_VARIANT_ID="variant_pro_placeholder"
NEXT_PUBLIC_LEMON_SCALE_VARIANT_ID="variant_scale_placeholder"
NEXT_PUBLIC_LEMON_LIFETIME_VARIANT_ID="variant_lifetime_placeholder"

# Stripe (Optional)
STRIPE_SECRET_KEY="stripe_secret_key_placeholder"
STRIPE_WEBHOOK_SECRET="stripe_webhook_secret_placeholder"
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID="stripe_price_pro_placeholder"
NEXT_PUBLIC_STRIPE_SCALE_PRICE_ID="stripe_price_scale_placeholder"
NEXT_PUBLIC_STRIPE_LIFETIME_PRICE_ID="stripe_price_lifetime_placeholder"
