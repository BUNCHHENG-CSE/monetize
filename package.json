{
  "name": "devtool-monetization-wrapper",
  "version": "1.0.0",
  "description": "All-in-One Payments + Auth + Hosting Wrapper for Developer Tools",
  "private": true,
  "scripts": {
    "dev": "node \"./node_modules/next/dist/bin/next\" dev",
    "build": "node \"./node_modules/next/dist/bin/next\" build",
    "start": "node \"./node_modules/next/dist/bin/next\" start",
    "lint": "node \"./node_modules/next/dist/bin/next\" lint",
    "setup": "node scripts/setup.mjs",
    "db:init": "node scripts/db-init.mjs",
    "db:up": "node scripts/wsl-docker.mjs up",
    "db:down": "node scripts/wsl-docker.mjs down",
    "db:status": "node scripts/wsl-docker.mjs status",
    "db:logs": "node scripts/wsl-docker.mjs logs",
    "db:reset": "node scripts/wsl-docker.mjs reset",
    "db:gui": "node scripts/wsl-docker.mjs gui"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.0",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "nanoid": "^5.1.3",
    "next": "^15.1.7",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.7.0",
    "svix": "^1.61.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
