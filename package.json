{
  "name": "tct-monetize",
  "version": "1.0.0",
  "description": "TCT Monetize — All-in-One Payments + Auth + Hosting Wrapper for Developer Tools",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun scripts/sync-schema.mjs && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "setup": "bun scripts/setup.mjs",
    "postinstall": "bun scripts/sync-schema.mjs && prisma generate",
    "sync-schema": "bun scripts/sync-schema.mjs",
    "prisma:generate": "bun scripts/sync-schema.mjs && prisma generate",
    "prisma:push": "bun scripts/sync-schema.mjs && prisma db push",
    "prisma:studio": "prisma studio",
    "db:push": "bun scripts/sync-schema.mjs && prisma db push",
    "db:seed": "bun scripts/seed-db.mjs",
    "db:studio": "prisma studio",
    "db:switch": "bun scripts/switch-db.mjs",
    "db:test": "bun scripts/test-prisma.mjs",
    "db:up": "node scripts/wsl-docker.mjs up",
    "db:down": "node scripts/wsl-docker.mjs down",
    "db:status": "node scripts/wsl-docker.mjs status",
    "db:logs": "node scripts/wsl-docker.mjs logs",
    "db:reset": "node scripts/wsl-docker.mjs reset",
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/doctor.mjs && tsc --noEmit",
    "test:api": "bun scripts/test-api.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.0",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "nanoid": "^5.1.3",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.7.0",
    "svix": "^1.61.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
