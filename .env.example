# ==============================================================================
# All-in-One Payments + Auth + Hosting Wrapper for Developer Tools
# Environment Configuration
# ==============================================================================

# Next.js App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION (Clerk)
# Get keys at: https://dashboard.clerk.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_sample_clerk_key"
CLERK_SECRET_KEY="sk_test_sample_clerk_secret"
CLERK_WEBHOOK_SECRET="whsec_sample_clerk_webhook_secret"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ------------------------------------------------------------------------------
# 2. DATABASE (Direct PostgreSQL & Supabase)
# Local WSL Docker: postgres://postgres:postgres@localhost:5434/devtool_monetize
# Supabase Pooler: postgres://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# ------------------------------------------------------------------------------
POSTGRES_PORT="5434"
DATABASE_URL="postgres://postgres:postgres@localhost:5434/devtool_monetize"
DIRECT_URL="postgres://postgres:postgres@localhost:5434/devtool_monetize"

NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample_anon_key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample_service_role_key"

# ------------------------------------------------------------------------------
# 3. PAYMENTS - LEMON SQUEEZY (Merchant of Record - Default)
# Get keys at: https://app.lemonsqueezy.com/settings/api
# ------------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY="your_lemon_squeezy_api_key"
LEMONSQUEEZY_STORE_ID="your_store_id"
LEMONSQUEEZY_WEBHOOK_SECRET="your_webhook_signing_secret"

NEXT_PUBLIC_LEMON_PRO_VARIANT_ID="variant_123456"
NEXT_PUBLIC_LEMON_SCALE_VARIANT_ID="variant_654321"

# ------------------------------------------------------------------------------
# 4. PAYMENTS - STRIPE (Alternative / Optional Direct Billing)
# Get keys at: https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_sample_stripe_secret"
STRIPE_WEBHOOK_SECRET="whsec_sample_stripe_webhook"

NEXT_PUBLIC_STRIPE_PRO_PRICE_ID="price_pro_sample"
NEXT_PUBLIC_STRIPE_SCALE_PRICE_ID="price_scale_sample"

# ------------------------------------------------------------------------------
# 5. DEV TOOL SIMULATION MODE
# Set to "true" to run with in-memory mock data when Supabase/Clerk are not yet configured!
# ------------------------------------------------------------------------------
ENABLE_LOCAL_MOCK_FALLBACK="true"
