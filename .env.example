# ==============================================================================
# TCT Monetize (tct-monetize) — All-in-One Payments + Auth + Hosting Wrapper
# Environment Configuration (.env.example -> copy to .env.local)
# ==============================================================================
# NOTE: Every external service below is OPTIONAL during local development!
# When keys are omitted or left as sample placeholders, the app automatically
# runs in Sandbox Demo Mode (User: user_demo_123, Test Key: sk_test_demo).

# [Optional] Public base URL of your deployment (used for checkout redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM) — REQUIRED FOR PERSISTENCE
# Local Development (Zero external processes): SQLite (file:./dev.db)
# Production (Serverless PostgreSQL): Neon (https://neon.tech)
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Production Neon Serverless PostgreSQL (uncomment when deploying to Vercel):
# DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"
# DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Clerk) — OPTIONAL IN LOCAL DEMO MODE
# Get keys at: https://dashboard.clerk.com
# If left as sample_*, getAuthSession() resolves to demo user 'user_demo_123'.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_sample_clerk_key"
CLERK_SECRET_KEY="sk_test_sample_clerk_secret"
CLERK_WEBHOOK_SECRET="whsec_sample_clerk_webhook_secret"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ------------------------------------------------------------------------------
# 3. PAYMENTS: LEMON SQUEEZY (Merchant of Record — Default)
# Get keys at: https://app.lemonsqueezy.com/settings/api
# Handles global sales tax, EU VAT compliance, subscriptions, and tax invoices.
# ------------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY="your_lemon_squeezy_api_key"
LEMONSQUEEZY_STORE_ID="your_store_id"
LEMONSQUEEZY_WEBHOOK_SECRET="your_webhook_signing_secret"

NEXT_PUBLIC_LEMON_PRO_VARIANT_ID="variant_pro_monthly"
NEXT_PUBLIC_LEMON_SCALE_VARIANT_ID="variant_scale_monthly"
NEXT_PUBLIC_LEMON_LIFETIME_VARIANT_ID="variant_lifetime_access"

# ------------------------------------------------------------------------------
# 4. PAYMENTS: STRIPE (Alternative Direct Billing)
# Get keys at: https://dashboard.stripe.com/apikeys
# Switch providers.payments = "stripe" in monetize.config.ts to use Stripe.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_sample_stripe_secret"
STRIPE_WEBHOOK_SECRET="whsec_sample_stripe_webhook"

NEXT_PUBLIC_STRIPE_PRO_PRICE_ID="price_pro_monthly"
NEXT_PUBLIC_STRIPE_SCALE_PRICE_ID="price_scale_monthly"
NEXT_PUBLIC_STRIPE_LIFETIME_PRICE_ID="price_lifetime_access"

# ------------------------------------------------------------------------------
# 5. OPTIONAL LEGACY / AUXILIARY INTEGRATIONS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample_anon_key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample_service_role_key"
ENABLE_LOCAL_MOCK_FALLBACK="true"
